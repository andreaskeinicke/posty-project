# Server Configuration
PORT=3001
NODE_ENV=development

# Service Mode
# Set to 'true' to use mock service (no API costs)
# Set to 'false' to use real Claude API
MOCK_MODE=true

# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxx
# If lost, check: .credentials/ANTHROPIC_API_KEY.txt (local backup, gitignored)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model used by the AI recommendation engine (defaults to claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# Cloudflare API (Primary - FREE domain checking & registration)
# Get your API token: https://dash.cloudflare.com/profile/api-tokens
# Create token with these scopes:
#   - Account.Registrar (Read + Edit)
#   - Zone.Zone (Read) - optional, for DNS management
# Get Account ID from: https://dash.cloudflare.com/ (right sidebar)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Product Price ID
# Create a product in Stripe Dashboard first, then add the price ID here:
# Posty Plan: $5/month recurring
STRIPE_PRICE_ID=price_xxxxxxxxxxxxx

# Supabase Configuration
# The server throws at startup if URL, ANON_KEY or SERVICE_ROLE_KEY are missing.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend URL (for Stripe redirects)
FRONTEND_URL=http://localhost:3000

# Namecheap (domain registration)
# Sandbox: https://ap.web.sandbox.namecheap.com | Production API access requires approval
NAMECHEAP_API_USER=your_namecheap_username
NAMECHEAP_API_KEY=your_namecheap_api_key
NAMECHEAP_CLIENT_IP=your_public_ip
NAMECHEAP_SANDBOX=true
# Default registrant contact details used for registrations
NAMECHEAP_DEFAULT_FIRST_NAME=
NAMECHEAP_DEFAULT_LAST_NAME=
NAMECHEAP_DEFAULT_ADDRESS=
NAMECHEAP_DEFAULT_CITY=
NAMECHEAP_DEFAULT_STATE=
NAMECHEAP_DEFAULT_POSTAL_CODE=
NAMECHEAP_DEFAULT_COUNTRY=DK
NAMECHEAP_DEFAULT_PHONE=
NAMECHEAP_DEFAULT_EMAIL=
